# Configuração não secreta do painel Node.
# A porta 50104 é a alocação observada no servidor JavaScript.
ZENYX_PANEL_PORT=50104
ZENYX_DESKTOP_URL=https://astrosallers.enzonic.dev/vnc.html
# Diretório privado para o hash da senha e a senha inicial; não publicar seu conteúdo.
ZENYX_DATA_DIR=/home/container/.zenyx-panel

# O desktop Python usa a alocação observada 50130 e resolução 854x480.
# session.py gera uma senha VNC aleatória a cada início.
