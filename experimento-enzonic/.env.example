# NAO colocar credenciais reais no GitHub.
# Use as configuracoes/variaveis PRIVADAS do Pterodactyl.
# No servidor Python com imagem Docker personalizada:
PORT=8080
VNC_PASSWORD=defina-uma-senha-privada-forte
SCREEN_WIDTH=854
SCREEN_HEIGHT=480

# No servidor JavaScript:
PORT=3000
DASHBOARD_PASSWORD=defina-uma-senha-privada-diferente
# Endereco HTTPS da porta web ALLOCATED do desktop Python:
DESKTOP_URL=https://host-do-desktop.exemplo
# Opcional: persistir sessoes do painel entre reinicios:
DASHBOARD_SECRET=chave-aleatoria-secreta
