{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; manifest-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self' https://discord.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nrtsagqxlsmtkijetnya.supabase.co/functions/v1/valtrex-cloud/:path*"
    },
    {
      "source": "/plans",
      "destination": "/plans/index.html"
    },
    {
      "source": "/plans/",
      "destination": "/plans/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/api/auth/discord/callback",
      "has": [
        {
          "type": "host",
          "value": "valtrexapplications\\.vercel\\.app"
        }
      ],
      "destination": "https://synxapps.vercel.app/api/auth/discord/callback",
      "permanent": false
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "valtrexapplications\\.vercel\\.app"
        }
      ],
      "destination": "https://synxapps.vercel.app/:path",
      "permanent": false
    },
    {
      "source": "/api/auth/discord/callback",
      "has": [
        {
          "type": "host",
          "value": "systembux\\.vercel\\.app"
        }
      ],
      "destination": "https://synxapps.vercel.app/api/auth/discord/callback",
      "permanent": false
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "systembux\\.vercel\\.app"
        }
      ],
      "destination": "https://synxapps.vercel.app/:path",
      "permanent": false
    }
  ]
}
